# Copia este archivo como .env y completa los valores reales.
# Nunca subas el archivo .env real a git (ya está en .gitignore).

# --- MongoDB ---
# URI de MongoDB real (Atlas u otro). Si no se define, o falla la conexión,
# el backend usa un modo "mock" en memoria (mongomock) automáticamente.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=attendance_system

# --- CORS ---
# Dominios del frontend permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-frontend.vercel.app

# --- Envio de correo (SMTP) ---
# Cuenta institucional: eventospolitecnicointernacional@pi.edu.co
# Usa una "contraseña de aplicación" (App Password), nunca la contraseña normal.
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=eventospolitecnicointernacional@pi.edu.co
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=eventospolitecnicointernacional@pi.edu.co
EMAIL_FROM_NAME=Eventos Politécnico Internacional
EMAIL_USE_TLS=true

# --- Trello (envio masivo de WhatsApp) ---
# Ver GUIA_TRELLO_WHATSAPP.md para el paso a paso de como obtenerlas.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID_WHATSAPP_PENDING=
